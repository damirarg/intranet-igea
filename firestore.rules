rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn() && userEmail() == "damirodriguez81@gmail.com";
    }

    function hasModule(moduleName) {
      let permiso = get(/databases/$(database)/documents/permisos/$(userEmail())).data;
      return signedIn()
        && exists(/databases/$(database)/documents/permisos/$(userEmail()))
        && (
          ("modulos" in permiso && moduleName in permiso.modulos)
          || ("permisosPorModulo" in permiso && permiso.permisosPorModulo[moduleName] in ["ver", "editar"])
        );
    }

    function canEditModule(moduleName) {
      let permiso = get(/databases/$(database)/documents/permisos/$(userEmail())).data;
      return signedIn()
        && exists(/databases/$(database)/documents/permisos/$(userEmail()))
        && (
          ("modulos" in permiso && moduleName in permiso.modulos)
          || ("permisosPorModulo" in permiso && permiso.permisosPorModulo[moduleName] == "editar")
        );
    }

    match /documentos_dpp_proc/{documentoId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /permisos/{email} {
      allow read: if isAdmin() || (signedIn() && email == userEmail());
      allow write: if isAdmin();
    }

    match /usuarios/{email} {
      allow read: if isAdmin() || (signedIn() && email == userEmail());
      allow write: if isAdmin();
    }

    match /sugerencias/{sugerenciaId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.emailAutor == userEmail();
      allow update: if isAdmin()
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["votosMap"])
        );
      allow delete: if isAdmin()
        || (signedIn() && resource.data.emailAutor == userEmail());
    }

    match /saldos/{saldoId} {
      allow read: if isAdmin() || hasModule("saldos");
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          canEditModule("saldos")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "gestiones",
            "saldada",
            "fechaSaldada",
            "montoFinalCobrado",
            "saldo"
          ])
        );
    }

    match /guardias/{fecha} {
      allow read: if isAdmin() || hasModule("guardias");
      allow create, update, delete: if isAdmin() || canEditModule("guardias");
    }

    match /empleados_rrhh/{empleadoId} {
      allow read: if isAdmin() || hasModule("rrhh");
      allow create, update, delete: if isAdmin() || canEditModule("rrhh");
    }

    match /ausencias/{ausenciaId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
